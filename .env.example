# Copy to .env for local use, or set these as environment variables on your host.
# NEVER commit a real .env — it is gitignored.

# API key for the AI summary provider. Default provider is NVIDIA NIM -- get a key
# at https://build.nvidia.com. When set, the dashboard generates a plain-language
# AI summary for every scanned target. (The OPENCODE_* names are historical; the
# client is provider-neutral.)
OPENCODE_API_KEY=

# Model id and endpoint. Any OpenAI-compatible chat-completions provider works.
# Do NOT use OpenCode Zen "-free" ids: that tier only works inside the interactive
# OpenCode CLI and 400s for a plain API key. See osintdepintel/ai_summary.py.
OPENCODE_MODEL=nvidia/nemotron-3-ultra-550b-a55b
OPENCODE_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional: GitHub token enables the GitHub Advisory enrichment provider.
# GITHUB_TOKEN=

# Optional: override where the server reads config / writes reports (used by the
# container image). Defaults resolve relative to the project root.
# OSINT_CONFIG_PATH=examples/targets.json
# OSINT_OUTPUT_DIR=reports
