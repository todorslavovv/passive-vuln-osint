# Copy to .env for local use, or set these as environment variables on Railway.
# NEVER commit a real .env — it is gitignored.

# OpenCode Zen (OpenAI-compatible) API key. When set, the dashboard generates a
# plain-language AI summary for every scanned target.
# Get one at https://opencode.ai/zen
OPENCODE_API_KEY=

# OpenCode model id. Any id from https://opencode.ai/zen/v1/models is accepted, but
# the whole "-free" tier (including the default below, ling-3.0-flash-fin-free and
# the muse-spark contributor tiers) is usable only from the interactive OpenCode
# CLI: a plain API key gets HTTP 400 "OpenCode's free tier can only be used in
# OpenCode" and the dashboard writes its deterministic local summary instead.
# For real AI summaries use a paid id (e.g. claude-haiku-4-5) on a workspace that
# has a payment method. Do not use laguna-s-2.1-free — it was removed from the
# gateway and 401s with a misleading "not supported" error.
OPENCODE_MODEL=nemotron-3.5-lightning-free

# Optional: GitHub token enables the GitHub Advisory enrichment provider.
# GITHUB_TOKEN=

# Optional: override where the server reads config / writes reports (used by the
# container image). Defaults resolve relative to the project root.
# OSINT_CONFIG_PATH=examples/targets.json
# OSINT_OUTPUT_DIR=reports
