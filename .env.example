# Copy to .env for local use, or set these as environment variables on Railway.
# NEVER commit a real .env — it is gitignored.

# OpenCode Zen (OpenAI-compatible) API key. When set, the dashboard generates an
# OpenCode "Muse Spark" plain-language summary for every scanned target.
# Get one at https://opencode.ai/zen
OPENCODE_API_KEY=

# OpenCode model id. Default is Muse Spark 1.2 Free. Swap to any model from
# https://opencode.ai/zen/v1/models (e.g. nemotron-3-ultra-free) if you prefer.
OPENCODE_MODEL=muse-spark-1.2-contributor-free

# Optional: other providers already supported by the tool.
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# GITHUB_TOKEN=

# Optional: override where the server reads config / writes reports (used by the
# container image). Defaults resolve relative to the project root.
# OSINT_CONFIG_PATH=examples/targets.json
# OSINT_OUTPUT_DIR=reports
